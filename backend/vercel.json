{
  "version": 2,
  "builds": [
    {
      "src": "handler.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.11" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "handler.py"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url",
    "AI_SERVICE_URL": "@ai_service_url",
    "S3_ACCESS_KEY": "@s3_access_key",
    "S3_SECRET_KEY": "@s3_secret_key",
    "S3_BUCKET_NAME": "@s3_bucket_name",
    "JWT_SECRET_KEY": "@jwt_secret_key"
  }
}
